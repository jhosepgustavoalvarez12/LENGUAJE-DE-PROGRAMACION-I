Algoritmo SumaDosNumeros
	
	Definir l, altura, area, perimetro Como Entero
	
	Escribir "Ingrese la longitud de la base:"
	Leer l
	Escribir "Ingrese la longitud de la base:"
	Leer altura
	
	area<- (l*altura) / 2
	perimetro<- l+l+altura+altura 

	Escribir "El area del rectangulo es: ", area
	Escribir "El perimetro del rectangulo es:", perimetro
	
FinAlgoritmo